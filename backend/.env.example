# Copy to .env (gitignored) and fill in the values.

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Access control
# Comma-separated emails allowed to log in. They are added to the allowed_emails
# table at startup. Users with a pending family invite may also log in.
ALLOWED_EMAILS=you@example.com
# Can manage the allowlist via /api/admin/members (also allowed to log in)
ADMIN_EMAIL=you@example.com

# Production overrides (defaults in code work for local dev)
# ALLOWED_ORIGINS=https://your-domain.example
# FRONTEND_URL=https://your-domain.example
# SESSION_SECRET=generate-with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
